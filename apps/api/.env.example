# Server port
PORT=5000
# development | production | test
NODE_ENV=development
# Mongo URI. Dev default below; if unreachable in dev, an in-memory MongoDB is used automatically.
MONGO_URI=mongodb://127.0.0.1:27017/rrb_dev
# Long random string used to sign JWTs (REQUIRED in production)
JWT_SECRET=change-me-to-a-long-random-string
# JWT lifetime, e.g. 7d
JWT_EXPIRES_IN=7d
# Allowed CORS origins (public site, admin panel)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# SMTP (Brevo etc). If missing, emails are logged to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Restaurant Review Box <no-reply@example.com>"
# Cloudinary. If all three set, Cloudinary storage is used; otherwise local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: Atlas pieces, build MONGO_URI from these when MONGO_URI is unset in production
ATLAS_DB_USER=
ATLAS_DB_PASS=
