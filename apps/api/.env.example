# Server port
PORT=5000
# development | production | test
NODE_ENV=development
# Mongo URI. Dev default below; if unreachable in dev, an in-memory MongoDB is used automatically
# (data persisted in apps/api/.mongo-memory). REQUIRED in production.
MONGO_URI=mongodb://127.0.0.1:27017/rrb_dev
# Long random string used to sign JWTs and hash OTPs (REQUIRED in production)
JWT_SECRET=change-me-to-a-long-random-string
# JWT lifetime, e.g. 7d
JWT_EXPIRES_IN=7d
# bcrypt cost factor (default 10)
BCRYPT_ROUNDS=10
# Allowed CORS origins (public site, admin panel) - nothing else is allowed
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Public base URL of this API (used to build absolute image URLs). Default http://localhost:PORT
PUBLIC_API_URL=
# Where local uploads are stored (default apps/api/uploads, served at /uploads)
UPLOADS_DIR=

# Admin seed: `npm run seed:admin -w @rrb/api`; in non-production it is also auto-created on server start
ADMIN_EMAIL=admin@rrb.local
ADMIN_PASSWORD=Admin@12345

# SMTP (Brevo etc). If SMTP_HOST is empty, emails are printed to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Restaurant Review Box <no-reply@example.com>"

# Cloudinary. If all three are set, Cloudinary storage is used; otherwise local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting (set RATE_LIMIT_DISABLED=true in tests). Defaults shown.
RATE_LIMIT_DISABLED=false
RATE_LIMIT_MAX=600
LOGIN_RATE_MAX=20
REGISTER_RATE_MAX=10
FORGOT_RATE_MAX=5
RESEND_RATE_MAX=3

# Optional: comma-separated DNS servers, for networks that block SRV lookups used by mongodb+srv
DNS_SERVERS=
